# Docker Hub image coordinates used by infra/compose.prod.yml and infra/compose.runtime.yml.
DOCKERHUB_NAMESPACE=your-dockerhub-user
CALTREK_IMAGE_TAG=0.1.0

# Published host ports for local smoke tests with infra/compose.prod.yml.
WEB_PUBLISHED_PORT=3000
API_PUBLISHED_PORT=8080

# Published host port for infra/compose.runtime.yml Nginx.
NGINX_HTTP_PORT=80

# Build/runtime versions.
NODE_VERSION=24-alpine
JDK_VERSION=25

# Database credentials. Use strong values in production.
POSTGRES_DB=caltrek
POSTGRES_USER=caltrek
POSTGRES_PASSWORD=replace-with-a-strong-password

# Backend security and browser access.
CALTREK_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
PUBLIC_ORIGIN=https://caltrek.example.com
CALTREK_CORS_ALLOWED_ORIGINS=https://caltrek.example.com

# Baked into the web image at build time. Leave empty when deploying behind
# infra/compose.runtime.yml Nginx so browser API calls use the same origin.
NEXT_PUBLIC_API_BASE_URL=

# External providers.
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_USER_AGENT=caltrek/0.1 production
OPENFOODFACTS_TIMEOUT=PT2S
OPENFOODFACTS_MAX_RETRIES=1
